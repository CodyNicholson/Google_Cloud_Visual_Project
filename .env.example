# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file
# when it is missing. Add the lab's own settings (API keys, tuning knobs) below.
# Never put a real value in this file (it is committed): list each variable with an empty value.
# Passwords the stack needs (e.g. a database's) are required: docker-compose.yml uses
# ${VAR:?...} with no fallback, and pipeline-run.sh generates them (GENERATED_SECRETS).

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Localhost-only host port for the UI (the tunnel doesn't need it). Empty: Docker picks a free port.
FRONTEND_HOST_PORT=
